# Modello Ollama di default per il fallback locale sul Pi.
# La TUI permette comunque di switchare a runtime con F1.
ARTEFATTO_MODEL=gemma3:270m

# Endpoint Ollama "turbo" sul PC con GPU, via LAN. Se vuoto, F2 nella TUI
# mostra "turbo non configurato".
# OLLAMA_TURBO_URL=http://192.168.1.10:11434
# OLLAMA_TURBO_MODEL=qwen3:14b

# Forza la modalità REPL semplice (senza TUI Textual)
# ARTEFATTO_PLAIN=1

# (futuro) token bot Telegram per i comandi del Game Master
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_GM_CHAT_ID=
